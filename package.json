{
  "name": "personal-knowledge-intelligence",
  "version": "0.3.0-beta.1",
  "private": true,
  "description": "A browser extension for building personal knowledge.",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "wxt build",
    "test:browser": "node scripts/test-browser.mjs",
    "package": "npm run build && python scripts/package.py",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.5.438",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "wxt": "^0.21.5"
  }
}
